{
  "name": "InfiniteCardCollector",
  "serveAddress": "127.0.0.1",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/server"
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "Assets": {
        "$className": "Folder",
        "CardFrames": {
          "$className": "Folder",
          "ClassicFrameFixture": {
            "$className": "Model",
            "ClassicFrame": {
              "$className": "Part",
              "$properties": {
                "Anchored": true,
                "CanCollide": false,
                "CastShadow": false,
                "Color": [0.643, 0.518, 0.259],
                "Material": "SmoothPlastic",
                "Size": [4.2, 5.8, 0.24]
              }
            },
            "CardFace": {
              "$className": "Part",
              "$properties": {
                "Anchored": true,
                "CanCollide": false,
                "CastShadow": false,
                "Color": [0.922, 0.91, 0.863],
                "Material": "SmoothPlastic",
                "Size": [3.72, 5.32, 0.12]
              }
            },
            "RankMark": {
              "$className": "Part",
              "$properties": {
                "Anchored": true,
                "CanCollide": false,
                "CastShadow": false,
                "Color": [0.157, 0.176, 0.216],
                "Material": "SmoothPlastic",
                "Size": [0.72, 0.72, 0.1]
              }
            }
          }
        },
        "JokerProps": {
          "$className": "Folder"
        },
        "PackModels": {
          "$className": "Folder",
          "ClassicStarterPackFixture": {
            "$className": "Model",
            "PackBody": {
              "$className": "Part",
              "$properties": {
                "Anchored": true,
                "CanCollide": false,
                "CastShadow": false,
                "Color": [0.102, 0.157, 0.267],
                "Material": "SmoothPlastic",
                "Size": [3.8, 5.2, 0.4]
              }
            },
            "PackSeal": {
              "$className": "Part",
              "$properties": {
                "Anchored": true,
                "CanCollide": false,
                "CastShadow": false,
                "Color": [0.643, 0.518, 0.259],
                "Material": "SmoothPlastic",
                "Size": [3.2, 0.7, 0.12]
              }
            }
          }
        }
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "StarterGui": {
      "$className": "StarterGui",
      "App": {
        "$className": "ScreenGui",
        "$properties": {
          "DisplayOrder": 0,
          "IgnoreGuiInset": false,
          "ResetOnSpawn": false,
          "ZIndexBehavior": "Sibling"
        },
        "AppRoot": {
          "$className": "Frame",
          "$properties": {
            "AnchorPoint": [
              0.5,
              0.5
            ],
            "BackgroundTransparency": 1,
            "Position": {
              "UDim2": [
                [
                  0.5,
                  0
                ],
                [
                  0.5,
                  0
                ]
              ]
            },
            "Size": {
              "UDim2": [
                [
                  1,
                  0
                ],
                [
                  1,
                  0
                ]
              ]
            }
          }
        }
      }
    }
  }
}
